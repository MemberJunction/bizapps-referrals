{
  "name": "bizapps-referrals",
  "private": true,
  "version": "1.0.0",
  "license": "BUSL-1.1",
  "description": "BizApps Referrals - Professional Referral & Verified Directory Open App for MemberJunction",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n\\u274c Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:packages",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/referrals-entities\" --filter=\"@mj-biz-apps/referrals-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/referrals-*\"",
    "test": "turbo test --filter=\"@mj-biz-apps/referrals-*\"",
    "mj": "mj",
    "mj:migrate": "mj migrate --schema __mj_BizAppsReferrals --dir ./migrations",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsReferrals",
    "mj:codegen": "mj codegen",
    "change": "changeset",
    "version": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-referrals"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "^6.2.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.9.3",
    "typescript": "^5.9.3",
    "vitest": "1.6.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "@memberjunction/core": "6.2.1",
      "@memberjunction/core-entities": "6.2.1",
      "@memberjunction/global": "6.2.1"
    }
  }
}
